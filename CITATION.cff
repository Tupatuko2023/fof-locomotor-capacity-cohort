    orcid: "https://orcid.org/0009-0003-0217-8291"
version: 0.1.0
repository-code: "https://github.com/Tupatuko2023/fof-locomotor-capacity-cohort"
license: MIT
keywords:
  - fear of falling
  - locomotor capacity
  - reproducibility
  - synthetic data
  - research software
