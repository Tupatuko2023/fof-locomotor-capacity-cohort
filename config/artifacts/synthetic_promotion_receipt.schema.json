{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a1/synthetic_promotion_receipt.schema.json",
  "title": "A1 synthetic artifact promotion validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "receipt_classification", "artifact_id",
    "artifact_revision", "artifact_type", "artifact_path", "artifact_sha256",
    "artifact_hash_contract", "generator_path", "generator_repository_revision",
    "generator_sha256", "synthetic_input_bindings", "execution_identity_sha256",
    "validator_path", "validator_repository_revision", "validator_sha256",
    "validation_profile", "validation_result", "validated_checks",
    "supporting_evidence", "synthetic_disclaimer", "timestamp_policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}$"},
    "receipt_classification": {"const": "PUBLIC_SYNTHETIC_VALIDATION"},
    "artifact_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){2,}$"},
    "artifact_revision": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["TABLE", "SUPPLEMENT"]},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_hash_contract": {"enum": ["SHA256_EXACT_FILE_BYTES", "SHA256_EXACT_BUNDLE_MANIFEST_BYTES"]},
    "generator_path": {"type": "string", "minLength": 1},
    "generator_repository_revision": {"$ref": "#/$defs/git_sha"},
    "generator_sha256": {"$ref": "#/$defs/sha256"},
    "synthetic_input_bindings": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input_binding"}
    },
    "execution_identity_sha256": {"$ref": "#/$defs/sha256"},
    "validator_path": {"type": "string", "minLength": 1},
    "validator_repository_revision": {"$ref": "#/$defs/git_sha"},
    "validator_sha256": {"$ref": "#/$defs/sha256"},
    "validation_profile": {"enum": ["SINGLE_FILE_TABLE_V1", "QC_PROVENANCE_BUNDLE_V1"]},
    "validation_result": {"const": "PASS"},
    "validated_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/supporting_evidence"}},
    "synthetic_disclaimer": {"const": "Synthetic structural-validation evidence only; not study findings."},
    "timestamp_policy": {"const": "OMITTED_FROM_CANONICAL_IDENTITY"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["input_classification", "input_reference", "input_sha256", "control_reference", "control_sha256"],
      "properties": {
        "input_classification": {"const": "PUBLIC_SYNTHETIC_INPUT"},
        "input_reference": {"type": "string", "minLength": 1},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "control_reference": {"type": "string", "minLength": 1},
        "control_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "supporting_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "reference", "sha256"],
      "properties": {
        "classification": {"const": "PUBLIC_SYNTHETIC_VALIDATION_EVIDENCE"},
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
